<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>RabbitMessaging</PackageId>
        <Version>1.0.0</Version>
        <Description>Config-driven RabbitMQ producer/consumer plumbing shared across services: connection pooling with retry, topology declaration, and generic publish/consume hosting.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
        <PackageReference Include="Polly" Version="8.7.0" />
        <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
    </ItemGroup>

</Project>
